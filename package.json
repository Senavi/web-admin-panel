{
  "name": "site-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable Next.js site starter with a schema-driven custom admin panel.",
  "license": "MIT",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --conditions=react-server scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "e2e:prepare": "tsx --conditions=react-server scripts/e2e-prepare.ts",
    "content:sync": "tsx --conditions=react-server scripts/content-sync.ts",
    "content:check": "tsx --conditions=react-server scripts/content-check.ts",
    "tokens:generate": "tsx scripts/tokens.ts generate",
    "tokens:check": "tsx scripts/tokens.ts check",
    "dev:next": "next dev",
    "db:serve": "tsx --conditions=react-server scripts/db-serve.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.117.2",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "4.21.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@next/env": "16.4.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
