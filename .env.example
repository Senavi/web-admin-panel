# ─────────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to `.env.local` for local overrides (never commit).
# Development works with ZERO variables set: the app uses an embedded PGlite
# database in .data/pglite, local file storage in .data/uploads and a generated
# dev secret. Every variable below is validated by src/core/env-schema.ts.
#
# Production needs ZERO variables to deploy: without DATABASE_URL the site runs
# in preview mode (demo content, hidden from search engines, admin shows a setup
# guide). Neon: DATABASE_URL, AUTH_SECRET and the S3_* storage values. Supabase:
# DATABASE_URL and SUPABASE_SERVICE_ROLE_KEY. Each environment (production,
# staging) has its own values (docs/DEPLOYMENT.md § Environments).
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the site, used for canonical URLs, sitemap and OG tags.
# Optional on Netlify/Vercel (their site address is used: URL / DEPLOY_PRIME_URL,
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL). Set it for your own domain if the
# platform doesn't know it. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string, any provider.
# Neon: Connect → Connection pooling on (host with `-pooler`; TLS required). The
# direct host (without `-pooler`) is derived for migrations and the deploy lock.
# Supabase: Connect → Session pooler (`…pooler.supabase.com:5432`, recommended).
# Netlify/Vercel connect over IPv4: on Supabase's free plan only the shared pooler
# is reachable; `db.<ref>.supabase.co` addresses are IPv6 only.
# Unset in development → embedded PGlite; unset in production → preview mode.
DATABASE_URL=
# Connection used by migrations, scripts and the deploy lock. Optional: derived from
# DATABASE_URL (Neon: without `-pooler`; Supabase transaction pooler: port 5432).
DIRECT_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret for signing sessions and the site-gate cookie (min 32 chars).
# Generate with: openssl rand -base64 48
# Required in production with Neon or any non-Supabase database; a DIFFERENT value
# per environment (staging ≠ production). With Supabase it is optional: derived
# (HKDF-SHA256) from SUPABASE_SERVICE_ROLE_KEY (rotating that key signs everyone
# out). In development a random secret is generated into .data/.
AUTH_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────
# `local` (files in .data/uploads), `s3` or `supabase`. Defaults to `s3` when S3
# variables are set, `supabase` for a Supabase database, otherwise `local`.
STORAGE_DRIVER=
# S3-compatible storage: Neon Object Storage (endpoint of the branch, path-style),
# Cloudflare R2 (https://<account>.r2.cloudflarestorage.com, region auto), AWS…
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public bucket URL: raster images load from there (SVG via /api/media).
S3_PUBLIC_URL=
# Path-style requests (<endpoint>/<bucket>/<key>), required by Neon. Default true.
S3_FORCE_PATH_STYLE=true
# Staging with a non-branching store (R2, Supabase): public URL of the PRODUCTION
# bucket. Files missing here are read from there (read only, never written).
STORAGE_READ_FALLBACK_URL=
# Local storage is refused in production unless this is `true` (CI, self-hosting
# with a persistent disk).
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# Supabase project URL (Project Settings → Data API). Optional: derived from a
# Supabase DATABASE_URL (`postgres.<ref>` user or `db.<ref>.supabase.co` host).
SUPABASE_URL=
# Public anon key. Only used to verify the connection; the app never exposes it.
SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for uploaded media (created on deploy by `pnpm db:prepare`).
SUPABASE_STORAGE_BUCKET=media

# ── Maintenance ─────────────────────────────────────────────────────────────
# Bearer token protecting /api/cron/maintenance (min 16 chars). The endpoint is
# disabled when unset; maintenance tasks still run lazily.
CRON_SECRET=
# Set to true only for the staging branch (its own database): lets
# `pnpm db:migrate:deploy` migrate it. Pull-request previews never set it.
PREVIEW_DATABASE_ISOLATED=

# ── Environments ────────────────────────────────────────────────────────────
# Detected from Netlify/Vercel (main → production, staging branch → staging, others
# → preview). Override only when self-hosting: production|staging|preview|development
DEPLOYMENT_ENVIRONMENT=
# Staging only: form emails go to these team addresses (comma-separated), never to
# the client's recipients. Unset: staging saves requests without emailing them.
STAGING_MAIL_TO=

# How long the request proxy serves its cached site state before refreshing it in
# the background (ms). Default 15000 (60000 in development). Settings, staff and
# publishing changes reach other visitors within this time.
SITE_STATE_TTL_MS=
# `true` logs `Server-Timing:` lines (one per timed step) in production too
# (always on in development).
SERVER_TIMING=

# ── Forms ───────────────────────────────────────────────────────────────────
# Delivery destinations are configured per form in Settings → Requests; only the
# secrets live here. Emails: dev (default outside production, writes to
# .data/mail/), resend or smtp.
MAIL_PROVIDER=
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Signs webhook requests: header X-Signature: sha256=<hex HMAC of the body>.
FORMS_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
# Optional Cloudflare Turnstile (also set projectConfig.forms.turnstile.siteKey).
TURNSTILE_SECRET_KEY=

# ── Development seed ────────────────────────────────────────────────────────
# Development only: creates this admin user on first run. Ignored in production
# (use `pnpm admin:create` there). Password: min 12 chars, not a common password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
